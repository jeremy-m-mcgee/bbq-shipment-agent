.venv/
# uv.lock is the committed lock. A pip or poetry install resolves its own
# versions and must not leave a second one behind claiming to be authoritative.
poetry.lock
*.egg-info/
*.db
*.sqlite
# derived cache, rebuildable from ledger/*.jsonl at any time
*.duckdb
__pycache__/
.pytest_cache/
.ruff_cache/

# secrets. .env.example is the committed template — keep it tracked.
.env
.env.*
!.env.example

# Shippo rate cache written by ShippoQuoter during development.
# Real quotes captured as a test fixture live in tests/fixtures/ instead.
rate-cache*.json
rc*.json

# Live Shippo answers cached by `run plan`. A cache of an API, not a run
# artifact: delete it and the next run re-fetches.
.cache/

# The real recipient list holds names and home addresses.
# recipients.example.yaml is the committed template — keep it tracked.
recipients.yaml
recipients.*.yaml
!recipients.example.yaml

# Claude Code local state. Deliberately NOT ignoring all of .claude/: shared
# project config there (settings.json, agents/, skills/) is worth committing,
# and a blanket ignore would hide it silently. Only the two machine-local
# things are excluded.
#
# worktrees/ holds throwaway git worktrees. Each is its own repository, so
# `git add -A` picks one up as an embedded repo rather than as files —
# committed by accident once and amended back out.
.claude/settings.local.json
.claude/worktrees/

# Rehearsal output. `demo/demo.sh` writes runs to demo/ledger/ rather than to
# the committed ledger/, so practising the talk does not append five runs to an
# append-only file that ships. demo/roster.yaml and the runbook stay tracked —
# the roster holds public buildings, not homes, which is why it can be.
demo/ledger/
demo/.out/

# Personal notes and cheat sheets. `*.local.md` is the escape hatch for a
# working document that describes the repo without being part of it: it can go
# stale, it answers to nobody, and docs/design.md stays the committed account.
*.local.md

# macOS Finder metadata.
.DS_Store
