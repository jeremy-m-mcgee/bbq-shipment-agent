{
  "name": "bbq-shipment-agent",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    // Makes every `uv run` load .env. Absolute so it resolves from any cwd.
    // setup.sh seeds .env from .env.example, because uv exits 2 if the file
    // named here does not exist.
    "UV_ENV_FILE": "${containerWorkspaceFolder}/.env"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
